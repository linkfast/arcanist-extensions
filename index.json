      "id": "lyrics-languages",
      "name": "Lyrics Languages",
      "description": "Shows how lyrics in scripts many cannot read are pronounced (Japanese in romaji with furigana, Chinese in pinyin, Korean and other scripts in the Latin alphabet), and translates lyrics on request with your LLM or a local model.",
      "author": "LinkFast S.A.",
      "homepage": "https://github.com/linkfast/arcanist-lyrics-languages",
      "license": "AGPL-3.0-or-later",
      "official": false,
      "pricing": "open-source",
      "maintainers": [
        "gchiappe"
      ],
      "releases": [
        {
          "version": "0.1.0-alpha.1",
          "url": "https://github.com/linkfast/arcanist-lyrics-languages/releases/download/v0.1.0-alpha.1/arcanist-lyrics-languages-0.1.0-alpha.1.zip",
          "sha256": "0b78bd5eed421ceab3f26e4f0cef7299fbe6ff99e99949d660fdd37f06d1677a",
          "size": 7846103,
          "minServerVersion": "0.1.0-alpha.25"
        }
      ],
      "names": {
        "es": "Idiomas de las letras"
      },
      "descriptions": {
        "es": "Muestra cómo se pronuncian las letras en escrituras que muchos no leen (japonés en romaji con furigana, chino en pinyin, coreano y otras escrituras en alfabeto latino) y las traduce a pedido con tu LLM o un modelo local."
      },
      "icon": "icons/lyrics-languages.svg",
      "categories": [
        "lyrics",
        "languages"
      ]
    },
